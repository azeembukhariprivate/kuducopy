<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AssemblyName>KUDUCOPY</AssemblyName>
    <RootNamespace>Kuducopy</RootNamespace>
    <ApplicationIcon>Assets\KUDUCOPY.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <StartupObject>Kuducopy.Program</StartupObject>

    <Version>1.3.0</Version>
    <Product>KUDUCOPY</Product>
    <Company>Azeem Bukhari</Company>
    <Authors>Azeem Bukhari</Authors>
    <Copyright>Copyright © 2026 Azeem Bukhari</Copyright>
    <Description>KUDUCOPY - file copying with Windows Robocopy</Description>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>none</DebugType>
    <Optimize>true</Optimize>
  </PropertyGroup>

  <!--
    The screens are built in C# and the themes are XAML files loaded at startup, so the project
    needs no XAML compiler and builds with the plain .NET SDK on any operating system.
  -->
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="PresentationCore" />
    <Reference Include="PresentationFramework" />
    <Reference Include="WindowsBase" />
    <Reference Include="System.Xaml" />
    <Reference Include="System.Xml" />
    <Reference Include="System.Xml.Linq" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Runtime.Serialization" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Themes\*.xaml" LogicalName="Kuducopy.Themes.%(Filename).xaml" />
    <EmbeddedResource Include="Assets\KUDUCOPY.ico" LogicalName="Kuducopy.Assets.KUDUCOPY.ico" />
    <None Include="..\..\LICENSE" Link="LICENSE.txt" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\THIRD-PARTY-NOTICES.txt" Link="THIRD-PARTY-NOTICES.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
