<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- KUDUCOPY Light theme. KUDU family palette with a green accent, plus status colours for results. -->
    <Color x:Key="TextColor">#1B1B1B</Color>
    <Color x:Key="SelectionColor">#E3F4EA</Color>

    <SolidColorBrush x:Key="WindowBg" Color="#F3F3F3"/>
    <SolidColorBrush x:Key="SurfaceBg" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="SurfaceAltBg" Color="#FBFBFB"/>
    <SolidColorBrush x:Key="Text" Color="#1B1B1B"/>
    <SolidColorBrush x:Key="SubtleText" Color="#5C5C5C"/>
    <SolidColorBrush x:Key="BorderBrush" Color="#E0E0E0"/>
    <SolidColorBrush x:Key="InputBorder" Color="#C8C8C8"/>
    <SolidColorBrush x:Key="InputBg" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Accent" Color="#1F8F55"/>
    <SolidColorBrush x:Key="AccentText" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="LinkText" Color="#17804A"/>
    <SolidColorBrush x:Key="SelectionBg" Color="#E3F4EA"/>
    <SolidColorBrush x:Key="HoverBg" Color="#EFEFEF"/>
    <SolidColorBrush x:Key="ChipBg" Color="#E6F6EC"/>
    <SolidColorBrush x:Key="ChipText" Color="#14653A"/>
    <SolidColorBrush x:Key="NeutralChipBg" Color="#F0F0F0"/>
    <SolidColorBrush x:Key="BannerBg" Color="#E3F4EA"/>
    <SolidColorBrush x:Key="OverlayBg" Color="#B3F3F3F3"/>
    <SolidColorBrush x:Key="OkText" Color="#107C10"/>
    <SolidColorBrush x:Key="OkBg" Color="#DFF6DD"/>
    <SolidColorBrush x:Key="WarnText" Color="#8A5300"/>
    <SolidColorBrush x:Key="WarnBg" Color="#FFF4CE"/>
    <SolidColorBrush x:Key="BadText" Color="#C42B1C"/>
    <SolidColorBrush x:Key="BadBg" Color="#FDE7E9"/>
    <SolidColorBrush x:Key="MonoBg" Color="#F7F7F7"/>
    <SolidColorBrush x:Key="OffDot" Color="#8A8A8A"/>

    <!-- Built-in WPF parts (menus, dropdown lists, text selection) read these. -->
    <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.WindowTextBrushKey}" Color="#1B1B1B"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlTextBrushKey}" Color="#1B1B1B"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.MenuBrushKey}" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.MenuTextBrushKey}" Color="#1B1B1B"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#E3F4EA"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#1B1B1B"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#E3F4EA"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#1B1B1B"/>
</ResourceDictionary>
